# Evidence: runtime output is gitignored; Phase 9's curated demo examples
# (one real discovery run, replay runs covering success/business_outcome/
# hard_failure/interstitial-recovery, the escalation demo, and one
# stability report) are explicitly un-ignored below.
/evidence/**
!/evidence/**/
!/evidence/**/.gitkeep
!/evidence/discovery/transfer_funds_20260819T001611Z/**
!/evidence/replay/transfer_funds_20260819T001233Z/**
!/evidence/replay/transfer_funds_20260819T001240Z/**
!/evidence/replay/transfer_funds_20260819T001411Z/**
!/evidence/replay/transfer_funds_20260819T001427Z/**
!/evidence/replay/open_sub_account_20260819T005052Z/**
!/evidence/stability/lookup_member_balance_20260818T220801Z/**

# Same curation for the adaptation project's MERIDIAN CORE work: one real
# discovery run per capability, plus replay runs covering success,
# business_outcome (both source_share_on_hold and supervisor_override_
# required), hard_failure (a genuine session timeout), and the escalation
# demo (a risky step resolved by a human, not just blocked).
!/evidence/discovery/meridian_sign_on_20260827T021212Z/**
!/evidence/discovery/meridian_balance_inquiry_20260827T031107Z/**
!/evidence/discovery/meridian_funds_transfer_20260827T031853Z/**
!/evidence/discovery/meridian_place_hold_20260827T040851Z/**
!/evidence/replay/meridian_balance_inquiry_20260828T171435Z/**
!/evidence/replay/meridian_balance_inquiry_20260827T164938Z/**
!/evidence/replay/meridian_funds_transfer_20260827T170813Z/**
!/evidence/replay/meridian_place_hold_20260827T172903Z/**
!/evidence/replay/meridian_place_hold_20260827T235559Z/**

# Artifact store: real discovery-run output, gitignored like bank.db in
# general (a capability a reviewer records themselves is their own runtime
# state, not a repo file). Exception: the three ready-to-replay artifacts
# the README's "try it immediately" demos use are committed directly, so
# replay/escalation/stability work right after a clean checkout with no
# Ollama/LLM call required — discovery evidence alone (a capability.json
# snapshot inside one evidence/discovery/ run) isn't loadable by
# artifacts.storage, which reads from here.
/artifacts/store/**
!/artifacts/store/.gitkeep
!/artifacts/store/transfer_funds/
!/artifacts/store/transfer_funds/v3.json
!/artifacts/store/open_sub_account/
!/artifacts/store/open_sub_account/v1.json
!/artifacts/store/lookup_member_balance/
!/artifacts/store/lookup_member_balance/v3.json

# Same exception for the adaptation project's MERIDIAN CORE capabilities -
# the README's MERIDIAN replay/API/chatbot/dashboard commands need these to
# exist on a clean checkout too. meridian_place_hold keeps both v1 (still
# draft, intentionally - the escalation demo needs a risky step that's
# still blocked) and v2 (approved, for the normal successful-replay demo).
!/artifacts/store/meridian_sign_on/
!/artifacts/store/meridian_sign_on/v3.json
!/artifacts/store/meridian_balance_inquiry/
!/artifacts/store/meridian_balance_inquiry/v4.json
!/artifacts/store/meridian_funds_transfer/
!/artifacts/store/meridian_funds_transfer/v4.json
!/artifacts/store/meridian_place_hold/
!/artifacts/store/meridian_place_hold/v1.json
!/artifacts/store/meridian_place_hold/v2.json

