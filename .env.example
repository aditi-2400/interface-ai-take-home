# --- Mock bank app ---
MOCK_APP_HOST=127.0.0.1
MOCK_APP_PORT=8000
MOCK_APP_DB_PATH=./mock_app/bank.db

# --- Discovery LLM: Ollama (local, primary) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# --- Discovery LLM: fallback (paid API) ---
# Only used if Gemma 3n cannot complete the discovery flow after a genuine,
# time-boxed debugging effort. If this is used, the swap is documented as a
# decision in REPORT.md, not a silent fallback. Leave blank if unused.
FALLBACK_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Playwright / escalation ---
PLAYWRIGHT_HEADLESS=false
CDP_REMOTE_DEBUGGING_PORT=9222
