# --- Mock bank app ---
# The app itself reads only MOCK_APP_DB_PATH; host/port are passed as CLI
# flags to uvicorn directly (see README's Setup section), not read from env.
MOCK_APP_DB_PATH=./mock_app/bank.db

# --- Discovery LLM: Ollama (local, primary) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
LLM_TIMEOUT_SECONDS=180

# --- Discovery LLM: fallback (paid API) ---
# Only used if Gemma 4 cannot complete the discovery flow after a genuine,
# time-boxed debugging effort. Not wired into code — Gemma 4 completed every
# flow this project needed, so the fallback path was never exercised. Left
# here as a documented, honestly-unused placeholder for the decision CLAUDE.md
# calls for, not a silently broken feature.
FALLBACK_LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Escalation notification ---
# Optional. A desktop notification always fires when a run pauses for a
# human (macOS via osascript, terminal bell elsewhere) - zero setup needed.
# Set this to also post the same alert to a Slack channel via an incoming
# webhook. Leave blank to skip Slack entirely; nothing else depends on it.
SLACK_WEBHOOK_URL=

# --- Playwright / escalation ---
# Not read from env either — headless/CDP port are CLI flags (--headed,
# --cdp-port) on replay.engine / agent.discovery / replay.stability, so the
# same env doesn't have to mean the same behavior across every command that
# happens to load it. Kept here as documentation of the defaults those flags
# resolve to when omitted.
# PLAYWRIGHT_HEADLESS=true (default; pass --headed to show the browser)
# CDP_REMOTE_DEBUGGING_PORT=9222 (default; pass --cdp-port to override)
