{
  "capability_id": "transfer_funds",
  "version": 1,
  "target_app": "meridian-trust-core-banking",
  "description": "Transfer funds from one account to another, including the required two-step confirmation.",
  "inputs": [
    {
      "name": "from_account_id",
      "type": "integer",
      "required": true,
      "description": "Source account ID to transfer funds from."
    },
    {
      "name": "to_account_id",
      "type": "integer",
      "required": true,
      "description": "Destination account ID to transfer funds into."
    },
    {
      "name": "amount",
      "type": "decimal",
      "required": true,
      "description": "Dollar amount to transfer, e.g. '25.00'."
    }
  ],
  "steps": [
    {
      "action": "navigate",
      "locator": null,
      "input_binding": null,
      "value": "/accounts/{from_account_id}/transfer",
      "output_binding": null,
      "checkpoint": "text_contains:Transfer From Account",
      "risky": false
    },
    {
      "action": "type",
      "locator": {
        "strategy": "role",
        "value": "Destination account ID",
        "role": "textbox",
        "fallback_strategies": [
          {
            "strategy": "css_fallback",
            "value": "input[name=\"to_account_id\"]",
            "role": null,
            "fallback_strategies": []
          }
        ]
      },
      "input_binding": "to_account_id",
      "value": null,
      "output_binding": null,
      "checkpoint": null,
      "risky": false
    },
    {
      "action": "type",
      "locator": {
        "strategy": "role",
        "value": "Transfer amount in dollars",
        "role": "textbox",
        "fallback_strategies": [
          {
            "strategy": "css_fallback",
            "value": "input[name=\"amount\"]",
            "role": null,
            "fallback_strategies": []
          }
        ]
      },
      "input_binding": "amount",
      "value": null,
      "output_binding": null,
      "checkpoint": null,
      "risky": false
    },
    {
      "action": "click",
      "locator": {
        "strategy": "role",
        "value": "Continue",
        "role": "link",
        "fallback_strategies": [
          {
            "strategy": "text",
            "value": "Continue",
            "role": null,
            "fallback_strategies": []
          }
        ]
      },
      "input_binding": null,
      "value": null,
      "output_binding": null,
      "checkpoint": "text_contains:Confirm Transfer",
      "risky": false
    },
    {
      "action": "click",
      "locator": {
        "strategy": "role",
        "value": "Confirm Transfer",
        "role": "link",
        "fallback_strategies": [
          {
            "strategy": "text",
            "value": "Confirm Transfer",
            "role": null,
            "fallback_strategies": []
          }
        ]
      },
      "input_binding": null,
      "value": null,
      "output_binding": null,
      "checkpoint": "text_contains:Transfer Complete",
      "risky": true
    }
  ],
  "success_checkpoint": "text_contains:Transfer Complete",
  "outputs": [
    {
      "name": "new_from_balance",
      "type": "decimal",
      "extraction_locator": {
        "strategy": "css_fallback",
        "value": "xpath=//td[normalize-space(text())='New Balance (From):']/following-sibling::td[1]",
        "role": null,
        "fallback_strategies": []
      }
    }
  ],
  "risk_level": "risky",
  "known_business_outcomes": {
    "text_contains:Insufficient funds": "insufficient_funds",
    "text_contains:was not found": "account_not_found"
  },
  "approval_state": "draft"
}
